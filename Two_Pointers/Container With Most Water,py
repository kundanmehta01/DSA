<!-- https://leetcode.com/problems/container-with-most-water/description/ -->

class Solution:
    def maxArea(self, height: list[int]) -> int:
        l=0
        r=len(height)-1
        max_water = 0

        while l< r:
            W = r-l
            H = min(height[l],height[r])
            water = W*H
            max_water = max(max_water,water)

            if height[l]<height[r]:
                l+=1
            else:
                r-=1
        return max_water